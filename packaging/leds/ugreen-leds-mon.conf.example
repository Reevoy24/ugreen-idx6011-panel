# Front-LED settings for the UGREEN iDX6011 / iDX6011 Pro (static variant).
# Copy of this file is created as ugreen-leds-mon.conf on install and is
# never overwritten by a later install — edit that one, not this example.
# Read by both start.sh (base state at boot) and ugreen-leds-mon.sh
# (activity monitor). Apply changes by re-running start.sh.
#
# The key names match /etc/ugreen-leds.conf from the kernel-module setup on
# Proxmox/Debian, so the vocabulary is the same on either platform.

# =========== colors and brightness ===========
# Colors are "R G B", 0-255 each. Brightness is 1-255.
#   white "255 255 255"   blue "0 0 255"      yellow "255 255 0"
#   red   "255 0 0"       green "0 255 0"     orange "255 165 0"

COLOR_POWER="255 255 255"
BRIGHTNESS_POWER=144

COLOR_DISK_HEALTH="255 255 255"
BRIGHTNESS_DISK_LEDS=64

COLOR_NETDEV_NORMAL="255 255 255"
BRIGHTNESS_NETDEV_LED=96

# Color while blinking on activity (empty = same color as when idle).
COLOR_DISK_ACTIVE=""
COLOR_NETDEV_ACTIVE=""

# Bays with no disk in them. Empty = LED off, which is what you usually
# want on a half-populated NAS; set a color to light them anyway.
COLOR_DISK_EMPTY=""

# Blink timing in milliseconds (on, off).
BLINK_ON=300
BLINK_OFF=200

# =========== activity monitoring ===========

# Poll interval in seconds.
INTERVAL=2

# Blink the disk / network LEDs on activity at all (0 = static LEDs only).
DISK_ACTIVITY=1
NET_ACTIVITY=1

# How much traffic per poll counts as "busy". Without a threshold an idle
# NAS still blinks constantly: ZFS commits, logs and background broadcast
# traffic (ARP, mDNS, an open web UI) never let the counters rest. Lower
# these if the LEDs feel unresponsive, raise them if they still flicker
# while the system is idle.
DISK_THRESHOLD_KB=128
NET_THRESHOLD_KB=64

# Consecutive quiet polls before an LED goes back to solid. Keeps a bursty
# workload from flickering the LED between blinking and solid.
IDLE_HOLD=2

# =========== disk health ===========

# Turn a disk's LED red when the system reports a problem with it: a ZFS pool
# device that is not ONLINE or has read/write/checksum errors, and on TrueNAS
# any SMART alert TrueNAS raised for the disk (uncorrectable errors, failed
# self-test, ...). The disks themselves are never queried for this — a SMART
# query can reset a drive's spin-down timer — only state the system already
# has. The LED goes back to normal once the problem is gone (zpool clear, or
# TrueNAS no longer raising the alert).
DISK_HEALTH_CHECK=1
COLOR_DISK_FAIL="255 0 0"

# Seconds between health checks (cheap; TrueNAS alerts are read every 5th).
HEALTH_INTERVAL=60

# =========== disk and NIC mapping ===========

# Which front panel this is: "pro" (iDX6011 Pro: two LAN LEDs), "nonpro"
# (iDX6011: one LAN LED, so every bay LED sits one register earlier) or
# "auto" to tell them apart by the DMI product name.
LED_LAYOUT=auto

# Disks in bay order, bay 1 first; "-" marks an empty bay, e.g. "sdc - sda".
# Empty = auto: every disk lands on its own bay's LED, found through the SATA
# controller and port it hangs off. Check the result with
#   sh ugreen-leds-mon.sh --show-map
# and light a single bay to find it on the front with
#   sh ugreen-leds-mon.sh --identify 3
DISKS=""

# SATA port behind each bay, bay 1 first, e.g. "ata3 ata4 ata1 ata2 ata5 ata6".
# Empty = worked out from the controllers, which is what you want: ataN
# numbers can change between boots, the controller wiring cannot. Only set
# this if --show-map gets your bays wrong (and please report that).
BAY_ATA=""

# LAN1 LAN2. Empty = auto (physical NICs, sorted). On the non-Pro both
# ports share its single LAN LED.
NICS=""

# Leave the OS disk out of the auto-detected bay list (it is never idle).
# Only applies when DISKS is empty.
SKIP_BOOT_DISK=1

# Additional disks to leave out of the auto-detected list, e.g. "sdg sdh".
EXCLUDE_DISKS=""
