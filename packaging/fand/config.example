# ug-fand — fan control for the UGREEN iDX6011 (Pro and non-Pro).
# The daemon auto-detects the model by DMI:
#   * iDX6011 Pro      -> 4 fans (CPU + system), EC offsets 0x34 / 0xB0
#   * iDX6011 non-Pro  -> 2 system fans (no separate CPU fan), EC 0x96 / 0x9C
# On the non-Pro the two system fans also cool the CPU, so they are driven by
# whichever curve (cpu_* vs sys_*) demands more at the current temperatures.
# All settings are hot-reloaded on save (no restart needed).

# Active mode: silent | default | turbo
mode=default

# Polling / update interval in seconds (1..60)
interval=3

# Drive-temperature poll interval in seconds (5..3600, default 30). Outside
# Unraid every poll sends a real SMART query to each SATA disk (drivetemp),
# which audibly unparks the heads on many drives — so drive temps run on their
# own, slower clock than `interval` (HDDs heat up far too slowly for 3 s polls
# to matter). On Unraid the temps are read from emhttpd (disks.ini) at zero
# disk I/O and spun-down drives are left asleep.
#disk_interval=30

# Critical failsafe temperatures in degrees C (40..105). At or above these the
# fans are forced to 100% regardless of mode/curves. Defaults: 88 (CPU),
# 68 (disks/NVMe). NVMe temps use the drive's Composite sensor — the value the
# manufacturer's own warning/critical thresholds are specified against — so the
# defaults fit most drives; raise sys_crit only if yours legitimately runs hot.
#cpu_crit=88
#sys_crit=68

# Run even if the DMI product name is not an iDX6011 (NOT recommended —
# the EC fan registers are specific to these models). Uncomment to force.
#force=1

# Web dashboard (opt-in). Set a port to serve a browser dashboard with system
# stats + fan control on http://<nas-ip>:<port>/ — handy on the non-Pro (no
# display). LAN only; do NOT expose to the internet. Changing the port needs a
# daemon restart (mode/curve edits hot-reload). Leave unset to disable.
#api_port=8765
# Optional password protecting only the fan-control actions (monitoring stays
# open on the LAN). Leave unset for no password.
#api_password=changeme
# Mountpoint the web dashboard's Storage widget reports usage for (default "/").
# On TrueNAS the root is the read-only boot pool, so point this at a data pool
# for useful numbers. statvfs of a pool mountpoint covers the whole pool.
#storage_path=/mnt/tank

# Drives this host cannot see (opt-in, off by default). With an HBA passed
# through to a TrueNAS VM the pool disks belong to the guest: no /dev/sd*, no
# SMART, nothing for drivetemp — while the fans hang off THIS host's EC. Enable
# System > Services > SNMP in TrueNAS and put the VM's IP address here; ug-fand
# then follows the pool disks' temperatures (and the panel lists them as vm:sda,
# vm:sdb, ...). IP only, no host names. SNMPv2c.
#
# This adds no disk access at all: TrueNAS reads each disk every 5 minutes for
# its own graphs and the SNMP agent serves those cached values. (Asking the
# disks directly — smartctl, drivetemp — can reset their spin-down timer.)
#disk_temp_snmp=192.168.1.50
#disk_temp_snmp_community=public

# If the VM has not answered for this many seconds, its disks count as NOT
# MONITORED and the missing-sensor failsafe takes the fans to 100% — so expect
# full fans while the VM boots or reboots. Default 120; 0 = never expire.
#disk_temp_max_age=120

# Advanced: the file the SNMP poller writes and everything else reads
# (default /run/ug-fand/disk-temps). Without disk_temp_snmp, any other source
# may keep it current instead — one "sda=41" line per drive, "*" for a drive
# without a reading. Written atomically; the same freshness rule applies.
#disk_temp_file=/run/ug-fand/disk-temps

# Fan curves: comma-separated  TEMP:SPEED  points — TEMP in degrees C, SPEED in
# percent (0-100; 100 = full speed). The speed is interpolated between points
# and held flat below the first / above the last point. cpu_* curves follow the
# CPU temperature, sys_* the disk/NVMe temperature. Edit these freely; delete a
# line to fall back to the built-in default.
cpu_silent=0:14,64:14,74:35,82:71,88:100
cpu_default=0:15,60:15,70:38,78:71,86:100
cpu_turbo=0:25,55:25,66:66,75:93,82:100
sys_silent=0:20,54:20,60:45,64:75,68:100
sys_default=0:28,52:28,58:55,63:80,68:100
sys_turbo=0:48,47:48,51:76,55:96,58:100

# Safety: at/above cpu_crit (CPU) or sys_crit (disks) the fans go to 100%
# regardless of the curves (see above; defaults 88 / 68).
